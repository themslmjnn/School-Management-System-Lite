ENVIRONMENT=development

# Database
# Use 'db' when running via Docker Compose, 'localhost' when running locally
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PSSW=your_db_password
DB_NAME=sms_lite

# Redis
# Use 'redis' when running via Docker Compose, 'localhost' when running locally
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth
# Must be at least 32 characters
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_long

# Token Expiry
INVITE_TOKEN_EXPIRES_HOURS=48
RESET_PASSWORD_EXPIRES_MINUTES=15
EMAIL_CHANGE_CODE_EXPIRES_MINUTES=15

# Email — Resend (production)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=School Management System

# Email — Mailtrap (development/test)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password